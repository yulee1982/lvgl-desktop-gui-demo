void lv_ffmpeg_init(void)
{
    lv_img_decoder_t * dec = lv_img_decoder_create();
    lv_img_decoder_set_info_cb(dec, decoder_info);
    lv_img_decoder_set_open_cb(dec, decoder_open);
    lv_img_decoder_set_close_cb(dec, decoder_close);
 
#if LV_FFMPEG_AV_DUMP_FORMAT == 0
    av_log_set_level(AV_LOG_QUIET);
#endif
}
 
int lv_ffmpeg_get_frame_num(const char * path)
{
    int ret = -1;
    struct ffmpeg_context_s * ffmpeg_ctx = ffmpeg_open_file(path);
 
    if(ffmpeg_ctx) {
        ret = ffmpeg_ctx->video_stream->nb_frames;
        ffmpeg_close(ffmpeg_ctx);
    }
 
    return ret;
}
 
lv_obj_t * lv_ffmpeg_player_create(lv_obj_t * parent)
{
    lv_obj_t * obj = lv_obj_class_create_obj(MY_CLASS, parent);
    lv_obj_class_init_obj(obj);
    return obj;
}
 
lv_res_t lv_ffmpeg_player_set_src(lv_obj_t * obj, const char * path)
{
    LV_ASSERT_OBJ(obj, MY_CLASS);
    lv_res_t res = LV_RES_INV;
 
    lv_ffmpeg_player_t * player = (lv_ffmpeg_player_t *)obj;
 
    if(player->ffmpeg_ctx) {
        ffmpeg_close(player->ffmpeg_ctx);
        player->ffmpeg_ctx = NULL;
    }
 
    lv_timer_pause(player->timer);
 
    player->ffmpeg_ctx = ffmpeg_open_file(path);
 
    if(!player->ffmpeg_ctx) {
        LV_LOG_ERROR("ffmpeg_ctx is NULL");
        memset(&player->imgdsc, 0, sizeof(lv_img_dsc_t));
        goto failed;
    }
 
    lv_obj_update_layout(obj);
 
    // 获取对象当前尺寸作为目标尺寸
    int obj_width = lv_obj_get_width(obj);
    int obj_height = lv_obj_get_height(obj);
    
    // 如果对象尺寸为0，使用视频原始尺寸
    if(obj_width <= 0 || obj_height <= 0) {
        obj_width = player->ffmpeg_ctx->video_dec_ctx->width;
        obj_height = player->ffmpeg_ctx->video_dec_ctx->height;
        // 设置对象尺寸
        lv_obj_set_size(obj, obj_width, obj_height);
    }
    
    // 设置目标尺寸 - 确保不超过视频原始尺寸
    player->ffmpeg_ctx->target_width = LV_MIN(obj_width, player->ffmpeg_ctx->video_dec_ctx->width);
    player->ffmpeg_ctx->target_height = LV_MIN(obj_height, player->ffmpeg_ctx->video_dec_ctx->height);
 
    if(ffmpeg_image_allocate(player->ffmpeg_ctx) < 0) {
        LV_LOG_ERROR("ffmpeg image allocate failed");
        ffmpeg_close(player->ffmpeg_ctx);
        player->ffmpeg_ctx = NULL;
        goto failed;
    }
 
    bool has_alpha = player->ffmpeg_ctx->has_alpha;
    uint32_t data_size = 0;
 
    // 使用目标尺寸计算数据大小
    data_size = player->ffmpeg_ctx->target_width * player->ffmpeg_ctx->target_height;
    data_size *= has_alpha ? LV_IMG_PX_SIZE_ALPHA_BYTE : (LV_COLOR_SIZE / 8);
 
    player->imgdsc.header.always_zero = 0;
    player->imgdsc.header.w = player->ffmpeg_ctx->target_width;
    player->imgdsc.header.h = player->ffmpeg_ctx->target_height;
    player->imgdsc.data_size = data_size;
    player->imgdsc.header.cf = has_alpha ? LV_IMG_CF_TRUE_COLOR_ALPHA : LV_IMG_CF_TRUE_COLOR;
    
    // 使用第一个缓存作为初始显示数据
    pthread_mutex_lock(&player->ffmpeg_ctx->cache_mutex);
    player->imgdsc.data = player->ffmpeg_ctx->frame_cache[0].data;
    pthread_mutex_unlock(&player->ffmpeg_ctx->cache_mutex);
    
    if(player->imgdsc.data == NULL) {
        LV_LOG_ERROR("Failed to get image data");
        ffmpeg_close(player->ffmpeg_ctx);
        player->ffmpeg_ctx = NULL;
        goto failed;
    }
 
    // 设置图像源
    lv_img_set_src(obj, &(player->imgdsc));
 
    int period = ffmpeg_get_frame_refr_period(player->ffmpeg_ctx);
    
    if(period > 0) {
        player->ffmpeg_ctx->frame_period = period;
        LV_LOG_INFO("frame refresh period = %d ms, rate = %d fps",
                    period, 1000 / period);
        lv_timer_set_period(player->timer, period);
    }
    else {
        player->ffmpeg_ctx->frame_period = FRAME_DEF_REFR_PERIOD;
        LV_LOG_WARN("unable to get frame refresh period, using default: %d ms", FRAME_DEF_REFR_PERIOD);
        lv_timer_set_period(player->timer, FRAME_DEF_REFR_PERIOD);
    }
 
    // 启动解码线程
    player->ffmpeg_ctx->decoding = true;
    if(pthread_create(&player->ffmpeg_ctx->decode_thread, NULL, decode_thread_func, player) != 0) {
        LV_LOG_ERROR("Failed to create decode thread");
        player->ffmpeg_ctx->decoding = false;
        ffmpeg_close(player->ffmpeg_ctx);
        player->ffmpeg_ctx = NULL;
        goto failed;
    }
 
    res = LV_RES_OK;
 
failed:
    return res;
}
 
void lv_ffmpeg_player_set_cmd(lv_obj_t * obj, lv_ffmpeg_player_cmd_t cmd)
{
    LV_ASSERT_OBJ(obj, MY_CLASS);
    lv_ffmpeg_player_t * player = (lv_ffmpeg_player_t *)obj;
 
    if(!player->ffmpeg_ctx) {
        LV_LOG_ERROR("ffmpeg_ctx is NULL");
        return;
    }
 
    lv_timer_t * timer = player->timer;
 
    switch(cmd) {
        case LV_FFMPEG_PLAYER_CMD_START:
            // 发送跳转到开头的请求
            pthread_mutex_lock(&player->ffmpeg_ctx->cache_mutex);
            player->ffmpeg_ctx->seek_pending = true;
            player->ffmpeg_ctx->seek_target = 0;
            // 重置所有缓存
            for(int i = 0; i < MAX_CACHE_FRAMES; i++) {
                player->ffmpeg_ctx->frame_cache[i].ready = false;
            }
            player->ffmpeg_ctx->current_cache_idx = 0;
            player->ffmpeg_ctx->next_cache_idx = 0;
            pthread_mutex_unlock(&player->ffmpeg_ctx->cache_mutex);
            
            // 触发解码线程立即工作
            sem_post(&player->ffmpeg_ctx->decode_sem);
            
            lv_timer_resume(timer);
            LV_LOG_INFO("ffmpeg player start");
            break;
        case LV_FFMPEG_PLAYER_CMD_STOP:
            pthread_mutex_lock(&player->ffmpeg_ctx->cache_mutex);
            player->ffmpeg_ctx->seek_pending = true;
            player->ffmpeg_ctx->seek_target = 0;
            // 重置所有缓存
            for(int i = 0; i < MAX_CACHE_FRAMES; i++) {
                player->ffmpeg_ctx->frame_cache[i].ready = false;
            }
            player->ffmpeg_ctx->current_cache_idx = 0;
            player->ffmpeg_ctx->next_cache_idx = 0;
            pthread_mutex_unlock(&player->ffmpeg_ctx->cache_mutex);
            
            lv_timer_pause(timer);
            LV_LOG_INFO("ffmpeg player stop");
            break;
        case LV_FFMPEG_PLAYER_CMD_PAUSE:
            lv_timer_pause(timer);
            LV_LOG_INFO("ffmpeg player pause");
            break;
        case LV_FFMPEG_PLAYER_CMD_RESUME:
            lv_timer_resume(timer);
            LV_LOG_INFO("ffmpeg player resume");
            break;
        default:
            LV_LOG_ERROR("Error cmd: %d", cmd);
            break;
    }
}
 
void lv_ffmpeg_player_set_auto_restart(lv_obj_t * obj, bool en)
{
    LV_ASSERT_OBJ(obj, MY_CLASS);
    lv_ffmpeg_player_t * player = (lv_ffmpeg_player_t *)obj;
