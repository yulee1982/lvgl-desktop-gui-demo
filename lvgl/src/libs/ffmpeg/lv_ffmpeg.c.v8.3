/**********************
 *      TYPEDEFS
 **********************/
// 帧缓存结构
typedef struct {
    uint8_t *data;              // 帧数据
    int64_t pts;                // 显示时间戳
    int64_t duration;           // 帧持续时间
    bool ready;                 // 是否就绪
} frame_cache_t;
 
struct ffmpeg_context_s {
    AVFormatContext * fmt_ctx;
    AVCodecContext * video_dec_ctx;
    AVStream * video_stream;
    struct SwsContext * sws_ctx;
    AVFrame * frame;
    AVPacket *pkt;
    int video_stream_idx;
    enum AVPixelFormat video_dst_pix_fmt;
    bool has_alpha;
    uint32_t target_width;
    uint32_t target_height;
    uint32_t src_width;
    uint32_t src_height;
    uint32_t frame_period;
    bool needs_realloc;
 
    // 多线程和2缓存相关字段
    frame_cache_t frame_cache[MAX_CACHE_FRAMES]; // 2缓存
    int current_cache_idx;      // 当前显示的缓存索引
    int next_cache_idx;         // 下一个可用的缓存索引
    pthread_t decode_thread;    // 解码线程
    pthread_mutex_t cache_mutex; // 缓存互斥锁
    sem_t decode_sem;           // 解码信号量
    bool decoding;              // 解码线程运行标志
    bool seek_pending;          // 是否有跳转请求
    int64_t seek_target;        // 跳转目标位置
};
 
#pragma pack(1)
 
struct lv_img_pixel_color_s {
    lv_color_t c;
    uint8_t alpha;
};
 
#pragma pack()
 
